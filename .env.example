# .env — Configuración de entorno para CV dinámico Roberto Otárola

# Django Core
SECRET_KEY=django-insecure-reemplazar-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos (en local usa SQLite por defecto si DATABASE_URL no está definida)
DATABASE_URL=postgresql://usu_cv:pass_cv@localhost:5432/db_cv

# Almacenamiento de Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Configuración de Producción
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ADMIN_URL=admin/
