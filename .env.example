# .env.example (Copia este archivo a .env y rellena con tus valores reales)

# ── Django Security ──
SECRET_KEY=TU_SECRET_KEY_AQUI
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,alke-web-cv.onrender.com

# ── Base de Datos (Supabase / Render PostgreSQL) ──
DATABASE_URL=postgresql://postgres:user@host:5432/postgres

# ── Cloudinary (Persistencia de Fotos en Render Free Tier) ──
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET

# ── Supabase (Solo si usas el SDK directamente) ──
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# ── Admin Panel ──
DJANGO_ADMIN_URL=admin/
